{
  "random_seed": 42,
  "tfidf": {
    "ngram_range": [1, 3],
    "max_features": 5000
  },
  "word2vec": {
    "vector_size": 100,
    "window": 5,
    "min_count": 2,
    "sg": 1
  },
  "calibration": {
    "method": "sigmoid",
    "folds": 3
  },
  "evaluation": {
    "cv_folds": 5
  },
  "classifiers": {
    "class_weight": "balanced"
  },
  "classification": {
    "confidence_threshold": 0.5,
    "high_confidence_override": 0.85
  }
}
